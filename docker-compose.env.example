# Copy this file to .env and fill in all values before running docker-compose.
# Never commit .env to git.

# ── MySQL ──────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=baby_feeding
MYSQL_USER=appuser
MYSQL_PASSWORD=change_me_app_password

# ── Backend ────────────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_64_CHAR_RANDOM_HEX
# Session lifetimes. Both slide: an active user is transparently re-issued a
# token past the halfway point, so only real inactivity ends a session.
ACCESS_TOKEN_EXPIRE_MINUTES=720          # 12h — without "Keep me signed in"
REMEMBER_ME_EXPIRE_MINUTES=43200         # 30d — with it

# Google Sign-In. OAuth 2.0 "Web application" client ID from Google Cloud
# Console → APIs & Services → Credentials. The backend needs it to check the
# `aud` claim of incoming ID tokens; leave empty to disable Google sign-in.
# Not a secret — the same value is baked into the frontend bundle below.
GOOGLE_CLIENT_ID=

# Comma-separated allowed origins — use your actual production domain
CORS_ORIGINS=https://yourdomain.com

# ── Frontend (baked into JS bundle at build time) ──────────────────────────
# These must point to your public-facing domain, no trailing slash.
# /api prefix matches the nginx proxy_pass rule.
VITE_API_URL=https://yourdomain.com/api
VITE_WS_URL=wss://yourdomain.com/api
# Same value as GOOGLE_CLIENT_ID above. Your domain must also be listed under
# "Authorized JavaScript origins" on that OAuth client, or Google refuses to
# render the button. Leave empty and the button is simply not shown.
VITE_GOOGLE_CLIENT_ID=
